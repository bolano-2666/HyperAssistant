<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#26000000"
    android:clickable="true"
    android:focusable="true">

    <!-- 1. Apple Intelligence 风格全屏四周全彩柔光边框 -->
    <com.hyper.assistant.ui.SiriGlowOverlayView
        android:id="@+id/siriGlowView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. 底部主交互卡片群 (浮于最下层，支持点击外部空白关闭) -->
    <LinearLayout
        android:id="@+id/layoutBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- 2.1 展开式对话详情面板 (默认隐藏，提问后平滑展开) -->
        <LinearLayout
            android:id="@+id/layoutExpandedChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chat_ai_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- 顶部标题行 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvChatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="超级小爱 × Gemini"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModelBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="✨ Gemini 3.8 Flash · 高速多模态"
                        android:textColor="#8AB4F8"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnCloseOverlay"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_round_button"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </RelativeLayout>

            <!-- 用户提问气泡 (靠右展示) -->
            <TextView
                android:id="@+id/tvUserQuery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chat_user_bubble"
                android:maxWidth="280dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="正在聆听你的声音..."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 已深度思考折叠条 (1:1 还原超级小爱设计) -->
            <TextView
                android:id="@+id/tvThinkingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_deep_thinking_badge"
                android:text="🌀 已深度思考 (Gemini 3.8 Flash) ∨"
                android:textColor="#8AB4F8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- AI 生成的高清图片容器 -->
            <ImageView
                android:id="@+id/imgAiGenerated"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 保存生成图片到系统相册按钮 -->
            <Button
                android:id="@+id/btnSaveImageToGallery"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#34C759"
                android:text="💾 保存高清图片到系统相册"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- AI 回复正文滚动画布 -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxHeight="240dp">

                <TextView
                    android:id="@+id/tvAiResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text=""
                    android:textColor="#F5F5F7"
                    android:textSize="15sp" />
            </ScrollView>

            <!-- 底部工具芯片条 (复制、朗读、导出文件) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnExportDocument"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_suggestion_chip"
                    android:text="⬇️ 导出保存文件"
                    android:textColor="#E0E0E6"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnCopyResponse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_suggestion_chip"
                    android:text="📋 复制回答"
                    android:textColor="#E0E0E6"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnSpeakResponse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_suggestion_chip"
                    android:text="🔊 朗读"
                    android:textColor="#E0E0E6"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 手动打字输入框 (按需展开) -->
            <LinearLayout
                android:id="@+id/layoutTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etManualInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_suggestion_chip"
                    android:hint="发消息或继续提问..."
                    android:paddingHorizontal="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8E8E93"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSendText"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#3875F6"
                    android:text="发送"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>

        <!-- 2.2 已选中的附件文件标签 (浮于胶囊上方，支持一键移除) -->
        <LinearLayout
            android:id="@+id/layoutSelectedAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_suggestion_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAttachmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="240dp"
                android:singleLine="true"
                android:text="📎 论文报告.pdf"
                android:textColor="#34C759"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnRemoveAttachment"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_round_button"
                android:padding="3dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <!-- 2.3 胶囊上方浮动推荐气泡 (Chips) -->
        <HorizontalScrollView
            android:id="@+id/scrollSuggestionChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipScreenSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_suggestion_chip"
                    android:text="✨ 深度总结当前屏幕"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipGenerateImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_suggestion_chip"
                    android:text="🎨 AI 高清画图"
                    android:textColor="#FF9F0A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipPromptPoem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_suggestion_chip"
                    android:text="📙 古代诗人怎么表达 emo 情绪"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipCreativeWriting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_suggestion_chip"
                    android:text="🎯 找潮流梗王一秒 get 最新热梗"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 2.4 核心底部悬浮胶囊药丸 (Capsule Dock) -->
        <LinearLayout
            android:id="@+id/cardCapsuleDock"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_capsule_dock"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- 左侧 1：相机识图 / 屏幕感知 -->
            <ImageView
                android:id="@+id/btnScreenCapture"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_round_button"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_camera" />

            <!-- 左侧 2：新增 [📎 附件] 按钮 (支持图片与文档选择) -->
            <ImageView
                android:id="@+id/btnAttachFile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_round_button"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_add" />

            <!-- 中间提示语与录音交互区 (长按录音，松手发送) -->
            <LinearLayout
                android:id="@+id/layoutDockCenter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCapsuleHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我在听..."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCapsuleSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按住说话 · 双击打字"
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 右侧 4 色动态跳动波形条 (随麦克风振幅律动) -->
            <com.hyper.assistant.ui.EqualizerBarView
                android:id="@+id/equalizerBarView"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp" />

            <!-- 右侧展开键盘打字按钮 [+] -->
            <ImageView
                android:id="@+id/btnSwitchKeyboard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_round_button"
                android:padding="8dp"
                android:src="@android:drawable/ic_input_get" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
